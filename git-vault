#!/usr/bin/env python3
"""git-vault: manage multiple git identities/credentials, aws-vault style.

    git vault add --name work --user-name "Me" --email me@corp.com
    git commit --vault work -m "msg"      (needs `eval "$(git-vault shell-init)"`)

Per invocation, injects author identity, HTTPS credentials (via a credential
helper), SSH key and signing key for the chosen vault. Nothing is written to
any repo's or global git config.
"""
import argparse
import getpass
import json
import os
import platform
import re
import shlex
import shutil
import tempfile
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path(os.environ.get("GIT_VAULT_HOME", Path.home() / ".config" / "git-vault"))
DB = HOME / "vaults.json"
VERSION = "0.1.0"
SERVICE = "git-vault"
NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")

SHELL_INIT = r'''# git-vault shell integration
export GIT_VAULT_SHELL=1
git() {
  if [ "$1" = add ] && [ "$2" = vault ]; then
    shift 2
    command git-vault add "$@"
    return
  fi
  local _a
  for _a in "$@"; do
    case "$_a" in
      --vault|--vault=*) command git-vault run "$@"; return ;;
    esac
  done
  if [ -n "${GIT_VAULT:-}" ]; then
    command git-vault run "$@"
    return
  fi
  command git "$@"
}
'''


def die(msg, code=1):
    print(f"git-vault: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------- storage ----------

def load_db():
    if not DB.exists():
        return {}
    return json.loads(DB.read_text())


def save_db(db):
    HOME.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = DB.with_suffix(".tmp")
    tmp.write_text(json.dumps(db, indent=2, sort_keys=True) + "\n")
    os.chmod(tmp, 0o600)
    tmp.replace(DB)


def get_vault(name):
    db = load_db()
    if name not in db:
        die(f"no such vault: {name} (try `git-vault list`)")
    return db[name]


class Secrets:
    """Keychain on macOS, 0600 files elsewhere (or GIT_VAULT_BACKEND=file)."""

    def __init__(self):
        backend = os.environ.get("GIT_VAULT_BACKEND")
        self.keychain = (backend or ("keychain" if platform.system() == "Darwin" else "file")) == "keychain"

    def _file(self, name):
        return HOME / "secrets" / name

    def get(self, name):
        if self.keychain:
            r = subprocess.run(
                ["security", "find-generic-password", "-a", name, "-s", SERVICE, "-w"],
                capture_output=True, text=True)
            return r.stdout.rstrip("\n") if r.returncode == 0 else None
        f = self._file(name)
        return f.read_text() if f.exists() else None

    def set(self, name, secret):
        if self.keychain:
            # NOTE: secret is briefly visible in argv to same-user `ps`.
            r = subprocess.run(
                ["security", "add-generic-password", "-a", name, "-s", SERVICE, "-U", "-w", secret],
                capture_output=True, text=True)
            if r.returncode:
                die(f"keychain write failed: {r.stderr.strip()}")
            return
        d = HOME / "secrets"
        d.mkdir(parents=True, exist_ok=True, mode=0o700)
        f = self._file(name)
        fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(secret)

    def delete(self, name):
        if self.keychain:
            subprocess.run(["security", "delete-generic-password", "-a", name, "-s", SERVICE],
                           capture_output=True)
        else:
            self._file(name).unlink(missing_ok=True)


# ---------- commands ----------

def cmd_add(a):
    if not NAME_RE.match(a.name):
        die("vault name must match [A-Za-z0-9._-]+")
    db = load_db()
    if a.name in db and not a.force:
        die(f"vault '{a.name}' exists (use --force to overwrite)")

    token = None
    if a.token_stdin:
        token = sys.stdin.readline().rstrip("\n")
    elif os.environ.get("GIT_VAULT_TOKEN"):
        token = os.environ["GIT_VAULT_TOKEN"]
    elif sys.stdin.isatty() and not a.no_token:
        token = getpass.getpass(f"Token/password for {a.host} (empty to skip): ") or None

    for key in (a.ssh_key,):
        if key and not Path(key).expanduser().exists():
            die(f"ssh key not found: {key}")

    db[a.name] = {
        "user_name": a.user_name,
        "email": a.email,
        "host": a.host,
        "username": a.username,
        "ssh_key": str(Path(a.ssh_key).expanduser()) if a.ssh_key else None,
        "signing_key": a.signing_key,
    }
    save_db(db)
    s = Secrets()
    if token:
        s.set(a.name, token)
    print(f"added vault '{a.name}'" + (" (token stored)" if token else " (no token)"))


def cmd_set(a):
    db = load_db()
    if a.name not in db:
        die(f"no such vault: {a.name}")
    v = db[a.name]
    for field in ("user_name", "email", "host", "username", "signing_key"):
        val = getattr(a, field)
        if val is not None:
            v[field] = val
    if a.ssh_key is not None:
        if a.ssh_key == "":
            v["ssh_key"] = None
        else:
            k = Path(a.ssh_key).expanduser()
            if not k.exists():
                die(f"ssh key not found: {a.ssh_key}")
            v["ssh_key"] = str(k)
    save_db(db)
    print(f"updated vault '{a.name}' (token untouched)")


def cmd_list(_a):
    db = load_db()
    if not db:
        print("no vaults. add one: git vault add --name <n> --user-name .. --email ..")
        return
    for n, v in sorted(db.items()):
        print(f"{n}\t{v.get('email') or '-'}\t{v.get('host')}")


def cmd_show(a):
    v = dict(get_vault(a.name))
    v["has_token"] = Secrets().get(a.name) is not None
    print(json.dumps(v, indent=2))


def cmd_remove(a):
    db = load_db()
    if a.name not in db:
        die(f"no such vault: {a.name}")
    del db[a.name]
    save_db(db)
    Secrets().delete(a.name)
    print(f"removed vault '{a.name}'")


def _post_json(url, data):
    req = urllib.request.Request(
        url, data=urllib.parse.urlencode(data).encode(),
        headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        die(f"{url}: HTTP {e.code} {e.read().decode(errors='replace')[:200]}")
    except urllib.error.URLError as e:
        die(f"{url}: {e.reason}")


def device_flow(host, client_id, scope):
    base = f"{os.environ.get('GIT_VAULT_SCHEME', 'https')}://{host}"
    d = _post_json(f"{base}/login/device/code", {"client_id": client_id, "scope": scope})
    if "device_code" not in d:
        die(f"device flow refused: {d.get('error_description') or d}")
    uri = d["verification_uri"]
    print(f"Open {uri} and enter code: {d['user_code']}", file=sys.stderr)
    print("Complete your SSO sign-in there; waiting...", file=sys.stderr)
    if platform.system() == "Darwin" and sys.stderr.isatty():
        subprocess.run(["open", uri], capture_output=True)
    interval = int(d.get("interval", 5))
    deadline = time.time() + int(d.get("expires_in", 900))
    while time.time() < deadline:
        time.sleep(interval)
        r = _post_json(f"{base}/login/oauth/access_token", {
            "client_id": client_id, "device_code": d["device_code"],
            "grant_type": "urn:ietf:params:oauth:grant-type:device_code"})
        if "access_token" in r:
            return r["access_token"]
        err = r.get("error")
        if err == "slow_down":
            interval = int(r.get("interval", interval + 5))
        elif err != "authorization_pending":
            die(f"login failed: {r.get('error_description') or err}")
    die("login timed out")


def token_from_gh(host, user):
    if not shutil.which("gh"):
        die("`gh` not found; install it, or use --client-id for device flow")
    cmd = ["gh", "auth", "token", "--hostname", host] + (["--user", user] if user else [])
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode or not r.stdout.strip():
        die(f"gh has no token for {host}{' / ' + user if user else ''}. "
            f"Run `gh auth login --hostname {host} --web` first (it handles SSO).")
    return r.stdout.strip()


def token_via_gh_web(host):
    """Fresh browser sign-in using gh in a throwaway config dir.

    Isolated, so gh's own accounts are untouched and each vault can sign in
    as a different user: pick the account in the browser when prompted.
    """
    if not shutil.which("gh"):
        die("`gh` not found; install it (brew install gh) or use --client-id")
    with tempfile.TemporaryDirectory() as d:
        env = {**os.environ, "GH_CONFIG_DIR": d}
        env.pop("GH_TOKEN", None)
        env.pop("GITHUB_TOKEN", None)
        r = subprocess.run(["gh", "auth", "login", "--hostname", host, "--web",
                            "--git-protocol", "https", "--skip-ssh-key"], env=env)
        if r.returncode:
            die("gh sign-in failed")
        r = subprocess.run(["gh", "auth", "token", "--hostname", host],
                           env=env, capture_output=True, text=True)
        if r.returncode or not r.stdout.strip():
            die("could not read token after sign-in")
        return r.stdout.strip()


def check_token(host, token):
    """Best-effort: who does this token belong to? Returns login or None."""
    scheme = os.environ.get("GIT_VAULT_SCHEME", "https")
    api = "https://api.github.com/user" if host == "github.com" else f"{scheme}://{host}/api/v3/user"
    req = urllib.request.Request(api, headers={"Authorization": f"Bearer {token}", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.load(r).get("login")
    except urllib.error.HTTPError as e:
        sso = e.headers.get("X-GitHub-SSO")
        if sso:
            print(f"warning: token needs SSO authorization: {sso}", file=sys.stderr)
    except (urllib.error.URLError, ValueError, OSError):
        pass
    return None


def cmd_login(a):
    db = load_db()
    if a.name not in db:
        die(f"no such vault: {a.name}. Create first: git vault add --name {a.name} --user-name .. --email .. --no-token")
    v = db[a.name]
    client_id = a.client_id or os.environ.get("GIT_VAULT_CLIENT_ID")
    if a.from_gh:
        token = token_from_gh(v["host"], a.gh_user)
    elif client_id:
        token = device_flow(v["host"], client_id, a.scope)
    else:
        print("Browser will open: sign in as the account for THIS vault "
              "(switch accounts on github.com first if needed).", file=sys.stderr)
        token = token_via_gh_web(v["host"])
    login = check_token(v["host"], token)
    Secrets().set(a.name, token)
    if login and not v.get("username"):
        v["username"] = login
        save_db(db)
    print(f"vault '{a.name}' signed in" + (f" as {login}" if login else " (token not verified)"))


def cmd_credential(a):
    """git credential helper. Only `get` does anything."""
    if a.op != "get":
        return
    v = get_vault(a.vault)
    req = dict(l.split("=", 1) for l in sys.stdin.read().splitlines() if "=" in l)
    host = req.get("host", "").split(":")[0]
    if host and host != v["host"]:
        return
    token = Secrets().get(a.vault)
    if not token:
        return
    print(f"username={v.get('username') or 'git'}")
    print(f"password={token}")


def split_vault(argv):
    out, vault, i = [], None, 0
    while i < len(argv):
        x = argv[i]
        if x == "--":
            out += argv[i:]
            break
        if x == "--vault":
            if i + 1 >= len(argv):
                die("--vault needs a name")
            vault, i = argv[i + 1], i + 2
            continue
        if x.startswith("--vault="):
            vault, i = x.split("=", 1)[1], i + 1
            continue
        out.append(x)
        i += 1
    return vault, out


def cmd_run(argv):
    vault, rest = split_vault(argv)
    vault = vault or os.environ.get("GIT_VAULT")
    env = os.environ.copy()
    cfg = []
    if vault:
        v = get_vault(vault)
        if v.get("user_name"):
            cfg += ["-c", f"user.name={v['user_name']}"]
        if v.get("email"):
            cfg += ["-c", f"user.email={v['email']}"]
        if v.get("signing_key"):
            cfg += ["-c", f"user.signingkey={v['signing_key']}", "-c", "commit.gpgsign=true"]
        helper = f"!{shlex.quote(sys.executable)} {shlex.quote(os.path.realpath(__file__))} credential --vault {shlex.quote(vault)}"
        cfg += ["-c", "credential.helper=", "-c", f"credential.helper={helper}"]
        if v.get("ssh_key"):
            env["GIT_SSH_COMMAND"] = f"ssh -i {shlex.quote(v['ssh_key'])} -o IdentitiesOnly=yes"
        env["GIT_VAULT_ACTIVE"] = vault
    os.execvpe("git", ["git", *cfg, *rest], env)


def cmd_doctor(_a):
    bad = 0

    def row(ok, label, hint=""):
        nonlocal bad
        mark = "ok  " if ok else "FAIL"
        bad += not ok
        print(f"[{mark}] {label}" + (f"  -> {hint}" if hint and not ok else ""))

    row(sys.version_info >= (3, 8), f"python {platform.python_version()}", "need python >= 3.8")
    g = shutil.which("git")
    row(bool(g), f"git ({g})" if g else "git", "install git")
    row(bool(shutil.which("git-vault")), "git-vault on PATH", "add its directory to PATH")
    row(os.environ.get("GIT_VAULT_SHELL") == "1", "shell integration loaded",
        'add: eval "$(git-vault shell-init)" to ~/.zshrc, then restart the shell')
    s = Secrets()
    row(not s.keychain or bool(shutil.which("security")), f"secret backend: {'keychain' if s.keychain else 'file'}")
    print(f"[info] gh {'found' if shutil.which('gh') else 'missing (needed for `login`; or use --client-id)'}")
    print(f"[info] {len(load_db())} vault(s) in {DB}")
    sys.exit(1 if bad else 0)


def cmd_shell_init(_a):
    print(SHELL_INIT, end="")


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "run":  # raw passthrough, no argparse
        cmd_run(argv[1:])
        return

    if argv and argv[0] in ("--version", "-V", "version"):
        print(f"git-vault {VERSION}")
        return

    p = argparse.ArgumentParser(prog="git-vault", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("add", help="create/update a vault")
    s.add_argument("--name", required=True)
    s.add_argument("--user-name", help="user.name for commits")
    s.add_argument("--email", help="user.email for commits")
    s.add_argument("--host", default="github.com", help="HTTPS host the token applies to")
    s.add_argument("--username", help="HTTPS username (default: git)")
    s.add_argument("--ssh-key", help="private key used for ssh remotes")
    s.add_argument("--signing-key", help="GPG/SSH signing key id; enables commit.gpgsign")
    s.add_argument("--token-stdin", action="store_true", help="read token from stdin")
    s.add_argument("--no-token", action="store_true", help="don't prompt for a token")
    s.add_argument("--force", action="store_true", help="overwrite existing vault metadata (token is kept unless a new one is given)")
    s.set_defaults(fn=cmd_add)

    s = sub.add_parser("login", help="browser/SSO sign-in for an existing vault")
    s.add_argument("--name", required=True)
    s.add_argument("--client-id", help="OAuth app client id for device flow (or GIT_VAULT_CLIENT_ID)")
    s.add_argument("--scope", default="repo", help="OAuth scopes (device flow)")
    s.add_argument("--from-gh", action="store_true", help="import the account gh already has (instead of fresh sign-in)")
    s.add_argument("--gh-user", help="gh account to import (multi-account)")
    s.set_defaults(fn=cmd_login)

    s = sub.add_parser("set", help="edit vault fields; keeps the token")
    s.add_argument("--name", required=True)
    s.add_argument("--user-name")
    s.add_argument("--email")
    s.add_argument("--host")
    s.add_argument("--username")
    s.add_argument("--ssh-key", help='path, or "" to clear')
    s.add_argument("--signing-key")
    s.set_defaults(fn=cmd_set)

    sub.add_parser("list", help="list vaults").set_defaults(fn=cmd_list)
    s = sub.add_parser("show", help="show vault (no secrets)")
    s.add_argument("name")
    s.set_defaults(fn=cmd_show)
    s = sub.add_parser("remove", help="delete vault + secret")
    s.add_argument("name")
    s.set_defaults(fn=cmd_remove)
    s = sub.add_parser("credential", help="git credential helper (internal)")
    s.add_argument("--vault", required=True)
    s.add_argument("op", nargs="?", default="get")
    s.set_defaults(fn=cmd_credential)
    sub.add_parser("doctor", help="check install and shell integration").set_defaults(fn=cmd_doctor)
    sub.add_parser("shell-init", help="print shell function enabling `git ... --vault X`").set_defaults(fn=cmd_shell_init)
    sub.add_parser("run", help="git-vault run <git args> [--vault X]")

    a = p.parse_args(argv)
    a.fn(a)


if __name__ == "__main__":
    main()
